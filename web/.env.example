# Lebarty Medicare — environment variables
# Copy this file to .env.local and fill in the real values.

# Site
NEXT_PUBLIC_SITE_URL=https://lebartymedicare.org
NEXT_PUBLIC_PRACTICE_PHONE=+2347010348626
NEXT_PUBLIC_PRACTICE_EMAIL=info@lebartymedicare.org

# Stripe (Foundation donations)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Supabase (non-PHI v1 data: blog content, donation records, contact submissions)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Tebra (booking widget — embedded; no API key needed for widget)
NEXT_PUBLIC_TEBRA_PRACTICE_SLUG=lebarty-medical

# Email (transactional, donation receipts)
POSTMARK_SERVER_TOKEN=

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
